package templates

// A general header template including tailwindcss and htmx installation  
templ Header() {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="UTF-8"/>
			<title>Tards</title>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<link href="static/output.css" rel="stylesheet"/>
		</head>
		<body hx-boost="true">
			<div id="nav" hx-get="/htmx/get-navbar" hx-trigger="revealed" hx-swap="innerHTML"></div>
			{ children... }
		</body>
	</html>
}


